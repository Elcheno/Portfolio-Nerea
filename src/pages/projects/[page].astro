---
import "./page.css";
import Layout from "../../layouts/Layout.astro";
import { Header, Footer, Button } from "@components/core";
import projectsList from "@services/projects.json";
import { Image } from "astro:assets";
import { getImage } from "@services/firebase";
import {
  ChangeProject,
  CoverProject,
  DescriptionProject,
  VideoProject,
} from "@components/pages/Project";

export async function getStaticPaths() {
  return projectsList.map((projectItem) => ({
    params: { page: projectItem.link },
  }));
}

const { page } = Astro.params;

const currentIndex = projectsList.findIndex((project) => project.link === page);
const projectData = projectsList[currentIndex];
const nextProject =
  currentIndex + 1 < projectsList.length
    ? projectsList[currentIndex + 1]
    : projectsList[0];
const prevProject =
  currentIndex - 1 >= 0
    ? projectsList[currentIndex - 1]
    : projectsList[projectsList.length - 1];
---

<Layout>
  <div class="w-full min-h-screen flex flex-col">
    <Header backbtn={true} />
    <div class="grow flex flex-col gap-15">
      <CoverProject project={projectData} />

      <DescriptionProject project={projectData} />

      {projectData?.video && <VideoProject project={projectData} />}

      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4 justify-center items-center gap-[6px]"
      >
        {
          projectData?.images?.map((image, key) => (
            <>
              {image && (
                <Image
                  src={getImage(image)}
                  inferSize={true}
                  alt={`Image number ${key + 1} of ${projectData?.name}`}
                  loading="lazy"
                  onclick="getFullscreen(this)"
                  class="cursor-pointer"
                />
              )}
            </>
          ))
        }
      </div>

      <ChangeProject nextProject={nextProject} prevProject={prevProject} />
    </div>
    <Footer />
  </div>
</Layout>

<script is:inline>
  function getFullscreen(element) {
    if (element.requestFullscreen) {
      element.requestFullscreen();
    } else if (element.webkitRequestFullscreen) {
      element.webkitRequestFullscreen();
    } else if (element.mozRequestFullScreen) {
      element.mozRequestFullScreen();
    } else if (element.msRequestFullscreen) {
      element.msRequestFullscreen();
    }
  }
</script>
