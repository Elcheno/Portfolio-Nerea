---
import "./page.css";
import Layout from "../../layouts/Layout.astro";
import { Header, Footer, Button } from "@components/core";
import projectsList from "@services/projects.json";

export async function getStaticPaths() {
  return projectsList.map((projectItem) => ({
    params: { page: projectItem.link },
  }));
}

const { page } = Astro.params;
const projectData = projectsList.find((project) => project.link === `${page}`);
const images = projectData?.carrousel_images?.map((image) => {
  return `/projects/${image}`;
});
---

<Layout>
  <div class="w-full min-h-screen flex flex-col">
    <Header backbtn={true} />
    <div class="grow flex justify-center items-center">
      <section class="m-auto flex flex-col gap-30 md:gap-8 mt-[20vh] w-[90%]">
        <div
          class="grid-custom grid grid-cols-1 lg:grid-cols-2 justify-between gap-12"
        >
          <div class="flex flex-col gap-4">
            <h1 class="project_name text-[1.8rem]">{projectData?.name}</h1>
            {
              projectData?.description?.map((desc) => (
                <p class="text-[1.2rem]">{desc}</p>
              ))
            }
            {
              projectData?.networks && (
                <div class="flex flex-row gap-6 items-center justify-center mt-6">
                  {Object.entries(projectData.networks).map(([key, url]) => (
                    <a href={url} target="_blank" rel="noopener noreferrer">
                      <Button text={`Visitar en ${key}`} />
                    </a>
                  ))}
                </div>
              )
            }
          </div>
          <div class="grid grid-cols-1 lg:grid-cols-2 2xl:grid-cols-3 gap-3">
            {
              images?.map((image) => {
                return <img src={image} />;
              })
            }
          </div>
        </div>
      </section>
    </div>
    <Footer />
  </div>
</Layout>
