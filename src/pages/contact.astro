---
import Layout from "src/layouts/Layout.astro";
import { Header, Footer, Card } from "@components/core";
import { ContactForm } from "@components/pages/Contact";
---

<Layout>
  <div class="w-full min-h-screen flex flex-col">
    <Header backbtn={true} />
    <div class="mt-20 grow">
      <div class="m-auto mt-20 flex flex-col gap-6 p-6">
        <div class="m-auto">
          <h1 class="text-[1.8rem] uppercase text-[#D9FF71]">
            ¡Contacta conmigo!
          </h1>
        </div>
        <Card className="m-auto">
          <ContactForm />
        </Card>
      </div>
    </div>
    <Footer />
  </div>
</Layout>
