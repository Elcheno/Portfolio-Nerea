---
import { Button } from "@components/core";

const { url } = Astro.props;
---

<div id="back_anchor" class="">
  <Button text="Volver" class="!px-3 !py-1 md:!px-[24px] md:!py-[10px]" />
</div>

<script>
  const anchor = document.getElementById("back_anchor");
  if (anchor) {
    anchor.addEventListener("click", function (event) {
      event.preventDefault();
      history.back();
    });
  }
</script>
