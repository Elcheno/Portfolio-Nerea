---
import { Image } from "astro:assets";
import Logo from "@assets/Logo.svg";
import { BackButton } from "@components/core";

const { backbtn } = Astro.props;
---

<div
  class="w-full md:h-[150px] flex items-center p-8 md:p-12 fixed top-0 z-1000"
>
  <div class="flex gap-6 bg-[#0B0B0B] py-4 px-6 rounded-full items-center">
    <a href="/" class=""
      ><Image src={Logo} alt="" height={50} width={50} loading="lazy" /></a
    >
    {backbtn && <BackButton url="" />}
  </div>
</div>
