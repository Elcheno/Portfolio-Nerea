---
import { Image } from "astro:assets";
import Logo from "@assets/Logo.svg";
import { BackButton } from "@components/core";

const { backbtn } = Astro.props;
---

<div
  class="w-full h-[100px] md:h-[150px] flex items-center p-8 md:p-12 fixed top-0 z-1000"
>
  <div class="flex gap-6 py-3 px-4 md:py-4 md:px-6 rounded-full items-center">
    <a href="/"
      ><Image
        src={Logo}
        alt=""
        height={50}
        width={50}
        loading="lazy"
        class="w-[30px] h-[30px] md:w-[50px] md:h-[50px] hidden md:block"
      /></a
    >
    {backbtn && <BackButton url="" />}
  </div>
</div>
