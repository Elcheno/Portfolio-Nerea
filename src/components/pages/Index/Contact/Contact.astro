---
import "./Contact.css";
import { Button } from "@components/core";
---

<section
  class="m-auto w-[80vw] md:w-full flex flex-col lg:gap-16 mt-40 md:mt-0"
>
  <div
    class="w-full flex items-center justify-center md:justify-start md:pt-20 md:pl-24"
  >
    <p
      class="w-full md:w-[50vw] text-[3rem] md:text-[3.8rem] 2xl:text-[4.5rem] leading-[1.2] uppercase"
    >
      El primer paso <br /> para algo grande
      <br /> empieza aquí
    </p>
  </div>

  <div id="contact" class="w-full flex flex-col items-center justify-center">
    <dotlottie-wc
      src="/Eyes.lottie"
      speed="1"
      style="width: 175px; height: 175px"
      mode="forward"
      loop
      autoplay></dotlottie-wc>
    <a href="/contact"><Button text="Contacta conmigo" /></a>
  </div>

  <script
    src="https://unpkg.com/@lottiefiles/dotlottie-wc@0.7.1/dist/dotlottie-wc.js"
    type="module"></script>
</section>
