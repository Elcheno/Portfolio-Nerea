---
import "./Contact.css";
import { Button } from "@components/core";
---

<section
  class="m-auto w-[80vw] md:w-full h-[65vh] md:h-[80vh] flex flex-col gap-36 mt-40 md:mt-0"
>
  <div
    class="w-full flex items-center justify-center md:justify-start md:pt-20 md:pl-24"
  >
    <p
      class="w-full md:w-[50vw] text-[3rem] md:text-[3.8rem] 2xl:text-[4.5rem] leading-[1.2] uppercase"
    >
      El primer paso <br /> para algo grande
      <br /> empieza aquí
    </p>
  </div>
  <div id="contact" class="w-full flex items-center justify-center">
    <a href="/contact"><Button text="Contacta conmigo" /></a>
  </div>
</section>
