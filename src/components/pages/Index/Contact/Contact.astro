---
import "./Contact.css";
import { Button } from "@components/core";
---

<section
  class="m-auto w-[80vw] md:w-full flex flex-col gap-10 lg:gap-[12vh] mb-[10vh] md:mt-40 lg:mt-10"
>
  <div
    class="w-full flex items-center justify-center md:justify-start md:pl-12 pt-30 md:pt-0 lg:pt-30 lg:pl-24"
  >
    <p
      class="w-full lg:w-[50vw] text-[1.8rem] md:text-[2.8rem] lg:text-[3.5rem] 2xl:text-[4.5rem] leading-[1.2] uppercase"
    >
      El primer paso <br /> para algo grande
      <br /> empieza aquí
    </p>
  </div>

  <div id="contact" class="w-full flex flex-col items-center justify-center">
    <dotlottie-wc
      src="/Eyes.lottie"
      speed="1"
      style="width: 175px; height: 175px"
      mode="forward"
      loop
      autoplay></dotlottie-wc>
    <a href="/contact" class="mt-[-2.5rem] z-10"
      ><Button text="Contacta conmigo" /></a
    >
  </div>

  <script
    src="https://unpkg.com/@lottiefiles/dotlottie-wc@0.7.1/dist/dotlottie-wc.js"
    type="module"></script>
</section>
