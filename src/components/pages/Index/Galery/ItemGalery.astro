---
import "./ItemGalery.css";
import { Image } from "astro:assets";

const { project } = Astro.props;
import { getImage } from "@services/firebase";
---

{
  project && (
    <a
      href={`/projects`}
      class="item w-full h-[30vh] md:w-[0] md:h-auto md:hover:cursor-pointer md:hover:w-[100px]"
    >
      <Image
        src={getImage(project.image_portada ?? project.images[0])}
        inferSize={true}
        alt={`Principal image of ${project.name}`}
        loading="lazy"
      />
      <div class="title_galery">{project?.name}</div>
      <div class="img_btn_galery">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-eye-icon lucide-eye"
        >
          <>
            <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" />
            <circle cx="12" cy="12" r="3" />
          </>
        </svg>
      </div>
    </a>
  )
}
