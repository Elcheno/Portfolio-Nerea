---
import ItemGalery from "./ItemGalery.astro";
import { Button } from "@components/core";
import projectsList from "@services/projects.json";

const projects_Ids = [0, 1, 5, 10, 9];

const projects = projects_Ids
  .map((id) => projectsList.find((project) => project.id === id))
  .filter(Boolean); // elimina posibles 'undefined' si un id no existe
---

<div
  class="mt-32 mb-16 md:mb-0 w-full flex flex-col gap-12 justify-center items-center"
>
  <section
    class="section-galery flex flex-col md:flex-row w-full md:h-[420px] relative"
  >
    {projects.map((project) => <ItemGalery project={project} />)}
  </section>
  <a href="/projects">
    <Button text="Ver más proyectos" />
  </a>
</div>
