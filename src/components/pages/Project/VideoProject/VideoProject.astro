---
import "./VideoProject.css";
const { project } = Astro.props;
---

<div class="relative mx-5 lg:mx-0 lg:fixed lg:top-5 lg:right-5 video-slide-in">
  <div class="flex flex-col lg:gap-2 lg:bg-[#0b0b0b] lg:p-2 lg:rounded-lg">
    <div class="hidden lg:block lg:text-[16px] lg:text-white font-bold">
      {project.video.label}
    </div>
    <video
      controls
      muted
      autoplay
      class="w-full lg:w-[22rem] h-auto rounded-lg shadow-lg"
    >
      <source src={project.video.src} type={project.video.type} />
    </video>
  </div>
</div>
