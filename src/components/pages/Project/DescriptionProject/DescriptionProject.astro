---
import { Button } from "@components/core";

const { project } = Astro.props;
---

<div class="flex flex-col gap-10 w-[90%] md:w-[75%] m-auto">
  <div>
    {
      project?.descriptions?.map((description: string) => (
        <p class="text-lg text-white text-center">{description}</p>
      ))
    }
  </div>
  {
    project?.networks && (
      <div class="flex flex-row gap-6 items-center justify-center mt-6">
        {Object.entries(project.networks).map(([key, url]) => (
          <a href={url as string} target="_blank" rel="noopener noreferrer">
            <Button text={`Visitar en ${key}`} />
          </a>
        ))}
      </div>
    )
  }
</div>
