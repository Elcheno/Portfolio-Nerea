---
import "./GaleryProjectsItem.css";
import { Image } from "astro:assets";
import { getImage } from "@services/firebase";

const { project } = Astro.props;
---

<a href={`/projects/${project.link}`} rel="noopener noreferrer">
  <div class="galery-item h-[20rem]">
    <Image
      src={getImage(project.image_portada ?? project.images[0])}
      inferSize={true}
      alt={`Principal image of ${project.name}`}
      loading="lazy"
      class="transition-all rounded-lg"
    />
    <div class="galery-item-name">{project.name}</div>
  </div>
</a>
