{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/images/**",
        "destination": "https://firebasestorage.googleapis.com/v0/b/portfolio-nophic-studio.firebasestorage.app/o/:path?alt=media"
      }
    ]
  },
  "headers": [
    {
      "source": "**/*.@(jpg|jpeg|gif|png|webp|avif|svg|mp4|webm)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=31536000,immutable"
        }
      ]
    }
  ]
}
